# Backend
MODEL_CONFIG_PATH=config/models.yaml
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# FlyAI CLI (authentication remains in the CLI's own configuration)
# Leave the path empty to auto-discover flyai.cmd/flyai from PATH.
FLYAI_CLI_PATH=
FLYAI_TIMEOUT_SECONDS=60
FLYAI_MAX_CONCURRENCY=3

# Single-agent tool loop safety limits
MAX_TOOL_ROUNDS=5
TOOL_EXECUTION_TIMEOUT_SECONDS=130

# Xiaohongshu-based LangGraph trip planner
TRIP_PLANNER_ENABLED=true
TRIP_PLANNER_MAX_DAYS=5
TRIP_PLANNER_MODEL_TIMEOUT_SECONDS=45
TRIP_PLANNER_REQUEST_EXTRACTION_TIMEOUT_SECONDS=30
XHS_MCP_TRANSPORT=stdio
# stdio: blank command uses the Python interpreter that started the API.
XHS_MCP_STDIO_COMMAND=
XHS_MCP_STDIO_ARGS=["-m","xhs_read_mcp","--transport","stdio","--headed"]
XHS_MCP_STDIO_CWD=D:/A_Project/xhs_mcp/xhs-read-mcp
# Streamable HTTP only:
XHS_MCP_URL=http://127.0.0.1:8765/mcp
# XHS_MCP_AUTH_TOKEN=copy-the-token-from-xhs-read-mcp
XHS_MCP_TIMEOUT_SECONDS=75
XHS_MIN_POST_CONTENT_CHARS=200
XHS_DETAIL_CANDIDATE_LIMIT=5

# Xiaomi MiMo
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Alibaba Cloud Model Studio / DashScope, China (Beijing)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Amap Web Service API
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_SECONDS=15
AMAP_MAX_RETRIES=1
AMAP_MIN_REQUEST_INTERVAL_SECONDS=0.2
AMAP_POI_MAX_CONCURRENCY=5
AMAP_ROUTE_MAX_CONCURRENCY=5
AMAP_POI_PAGE_SIZE=10
# Optional JSON object overriding per-namespace cache TTLs, in seconds.
# Example: {"place_search_v2": 3600, "route_plan": 600}
AMAP_CACHE_TTL_OVERRIDES=
MAX_RAW_POI_CANDIDATES=60
MAX_WALK_DISTANCE_METERS=1800
MAX_TRANSIT_TRANSFERS=1
MAX_TRANSIT_DURATION_MINUTES=90
TRIP_PLANNING_CLUSTER_MAX_ITERATIONS=20
TRIP_PLANNING_DATA_TIMEOUT_SECONDS=10

# Request context. Forwarding headers are ignored unless the direct peer is in this list.
APP_TIMEZONE=Asia/Shanghai
TRUSTED_PROXY_CIDRS=

# Comma-separated hosts that should connect directly instead of using terminal proxies.
TOUR_ASSISTANT_NO_PROXY_HOSTS=localhost,127.0.0.1,dashscope.aliyuncs.com,restapi.amap.com

# PostgreSQL (local Docker Compose)
POSTGRES_DB=tour_assistant
POSTGRES_USER=tour_assistant
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tour_assistant:replace-with-a-local-development-password@localhost:5432/tour_assistant

# Authentication and Redis
AUTH_ENABLED=true
APP_ENVIRONMENT=local
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
# Generate independent secrets with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_HMAC_SECRET=replace-with-a-different-32-character-secret
AUTH_COOKIE_SECURE=false
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_PHONE_LIMIT=5
AUTH_OTP_IP_LIMIT=20
AUTH_OTP_RATE_WINDOW_SECONDS=600
