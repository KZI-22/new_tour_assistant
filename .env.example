# Backend
MODEL_CONFIG_PATH=config/models.yaml
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# FlyAI CLI (authentication remains in the CLI's own configuration)
# Leave the path empty to auto-discover flyai.cmd/flyai from PATH.
FLYAI_CLI_PATH=
FLYAI_TIMEOUT_SECONDS=60
FLYAI_MAX_CONCURRENCY=3

# Single-agent tool loop safety limits
MAX_TOOL_ROUNDS=5
TOOL_EXECUTION_TIMEOUT_SECONDS=130

# Xiaohongshu-based LangGraph trip planner
TRIP_PLANNER_ENABLED=true
TRIP_PLANNER_MAX_DAYS=5
TRIP_PLANNER_MODEL_TIMEOUT_SECONDS=45
TRIP_PLANNER_REQUEST_EXTRACTION_TIMEOUT_SECONDS=30
XHS_MCP_TRANSPORT=stdio
# stdio: blank command uses the Python interpreter that started the API.
XHS_MCP_STDIO_COMMAND=
XHS_MCP_STDIO_ARGS=["-m","xhs_read_mcp","--transport","stdio","--headed"]
XHS_MCP_STDIO_CWD=D:/A_Project/xhs_mcp/xhs-read-mcp
# Streamable HTTP only:
XHS_MCP_URL=http://127.0.0.1:8765/mcp
# XHS_MCP_AUTH_TOKEN=copy-the-token-from-xhs-read-mcp
XHS_MCP_TIMEOUT_SECONDS=75
XHS_EVIDENCE_MAX_CHARS=12000
XHS_MIN_POST_CONTENT_CHARS=200
XHS_DETAIL_CANDIDATE_LIMIT=5

# Xiaomi MiMo
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Alibaba Cloud Model Studio / DashScope, China (Beijing)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Amap Web Service API
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_SECONDS=15
AMAP_MAX_RETRIES=1
AMAP_MIN_REQUEST_INTERVAL_SECONDS=0.2

# Request context. Forwarding headers are ignored unless the direct peer is in this list.
APP_TIMEZONE=Asia/Shanghai
TRUSTED_PROXY_CIDRS=

# Comma-separated hosts that should connect directly instead of using terminal proxies.
TOUR_ASSISTANT_NO_PROXY_HOSTS=localhost,127.0.0.1,dashscope.aliyuncs.com

# PostgreSQL (local Docker Compose)
POSTGRES_DB=tour_assistant
POSTGRES_USER=tour_assistant
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tour_assistant:replace-with-a-local-development-password@localhost:5432/tour_assistant
